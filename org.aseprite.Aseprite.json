{
  "app-id": "org.aseprite.Aseprite",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "23.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "aseprite",
  "finish-args": [
    "--share=ipc",
    "--socket=x11",
    "--socket=wayland",
    "--filesystem=host",
    "--device=dri"
  ],
  "modules": [
    {
      "name": "libjpeg-turbo",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=RELEASE"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/libjpeg-turbo/libjpeg-turbo/archive/refs/tags/3.0.1.tar.gz",
          "sha256": "5b9bbca2b2a87c6632c821799438d358e27004ab528abf798533c15d50b39f82"
        }
      ]
    },
    {
      "name": "skia",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/skia",
        "cp -r . /app/skia"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/aseprite/skia/releases/download/m124-08a5439a6b/Skia-Linux-Release-x64.zip",
          "sha256": "a327e89b244f24cecaa34eb37544bae00d447b96c583d26ed29d6a3ad2e8a8b8",
          "strip-components": 0
        }
      ]
    },
    {
      "name": "aseprite",
      "buildsystem": "cmake-ninja",
      "builddir": true,
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=RelWithDebInfo",
        "-DCMAKE_CXX_FLAGS=-Wno-dangling",
        "-DLAF_BACKEND=skia",
        "-DSKIA_DIR=/app/skia",
        "-DSKIA_LIBRARY_DIR=/app/skia/out/Release-x64",
        "-DSKIA_LIBRARY=/app/skia/out/Release-x64/libskia.a"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/aseprite/aseprite.git",
          "tag": "v1.3.17",
          "commit": "c48fa3b1de38098d74e5c5fc2b7f6ac43d2b5329",
          "submodules": true
        }
      ]
    }
  ]
}
